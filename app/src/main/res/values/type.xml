<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's typeface, Nunito, on Material 3's type scale (whose styles set their own
         typeface, so each one is redefined) and on the platform's text appearances, which
         the settings screens and lists use. Titles and labels take the semibold weight. -->
    <style name="TextAppearance.GBCG.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/nunito</item>
        <item name="android:fontFamily">@font/nunito</item>
    </style>

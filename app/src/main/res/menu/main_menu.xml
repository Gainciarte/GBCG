<?xml version="1.0" encoding="utf-8"?>
<!-- Only Settings stays on the bar; the rest goes in its overflow menu -->
<menu
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/chooseFolderItem"
        android:icon="@drawable/ic_folder_open_24dp"
        android:title="@string/choose_rom_folder"
        app:maxButtonHeight="?attr/actionBarSize"
        app:showAsAction="never" />

    <item
        android:id="@+id/importItem"
        android:icon="@drawable/ic_library_add_24dp"
        android:title="@string/import_saves"
        app:maxButtonHeight="?attr/actionBarSize"
        app:showAsAction="never" />

    <item
        android:id="@+id/exportItem"
        android:icon="@drawable/ic_save_move_24dp"
        android:title="@string/export_saves"
        app:maxButtonHeight="?attr/actionBarSize"
        app:showAsAction="never" />

    <item
        android:id="@+id/settingsItem"
        android:icon="@drawable/ic_settings_24dp"
        android:title="@string/settings"
        app:maxButtonHeight="?attr/actionBarSize"
        app:showAsAction="always" />
</menu>

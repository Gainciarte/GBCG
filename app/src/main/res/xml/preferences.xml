<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Not stored with the other settings: AppCompat keeps the app's language -->
    <com.philj56.gbcc.settings.SummaryListPreference
        app:entries="@array/language_names_array"
        app:entryValues="@array/language_values_array"
        app:icon="@drawable/ic_translate_24dp"
        app:key="app_language"
        app:persistent="false"
        app:title="@string/settings_language" />

    <Preference
        app:key="controls"
        app:title="@string/settings_category_controls"
        app:summary="@string/settings_category_controls_summary"
        app:icon="@drawable/ic_gamepad_24dp">
        <intent
            android:targetPackage="@string/application_id"
            android:targetClass="com.philj56.gbcc.ControlsSettingsActivity" />
    </Preference>

    <Preference
        app:key="image"
        app:title="@string/settings_category_image"
        app:summary="@string/settings_category_image_summary"
        app:icon="@drawable/ic_image_24dp">
        <intent
            android:targetPackage="@string/application_id"
            android:targetClass="com.philj56.gbcc.ImageSettingsActivity" />
    </Preference>

    <Preference
        app:key="sound"
        app:title="@string/settings_category_sound"
        app:summary="@string/settings_category_sound_summary"
        app:icon="@drawable/ic_music_note_24dp">
        <intent
            android:targetPackage="@string/application_id"
            android:targetClass="com.philj56.gbcc.SoundSettingsActivity" />
    </Preference>

    <Preference
        app:key="advanced"
        app:title="@string/settings_category_advanced"
        app:summary="@string/settings_category_advanced_summary"
        app:icon="@drawable/ic_cogs_24dp">
        <intent
            android:targetPackage="@string/application_id"
            android:targetClass="com.philj56.gbcc.AdvancedSettingsActivity" />
    </Preference>

    <Preference
        app:key="about"
        app:title="@string/settings_category_about"
        app:summary="@string/settings_category_about_summary"
        app:icon="@drawable/ic_information_24dp">
        <intent
            android:targetPackage="@string/application_id"
            android:targetClass="com.philj56.gbcc.AboutSettingsActivity" />
    </Preference>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="hidden_category"
        app:isPreferenceVisible="false">

        <ListPreference
            app:key="button_map_a"
            app:defaultValue="b" />
        <ListPreference
            app:key="button_map_b"
            app:defaultValue="a" />
        <ListPreference
            app:key="button_map_x"
            app:defaultValue="unmapped" />
        <ListPreference
            app:key="button_map_y"
            app:defaultValue="menu" />
        <ListPreference
            app:key="button_map_up"
            app:defaultValue="up" />
        <ListPreference
            app:key="button_map_down"
            app:defaultValue="down" />
        <ListPreference
            app:key="button_map_left"
            app:defaultValue="left" />
        <ListPreference
            app:key="button_map_right"
            app:defaultValue="right" />
        <ListPreference
            app:key="button_map_start"
            app:defaultValue="start" />
        <ListPreference
            app:key="button_map_select"
            app:defaultValue="select" />
        <ListPreference
            app:key="button_map_l1"
            app:defaultValue="back" />
        <ListPreference
            app:key="button_map_l2"
            app:defaultValue="unmapped" />
        <ListPreference
            app:key="button_map_r1"
            app:defaultValue="unmapped" />
        <ListPreference
            app:key="button_map_r2"
            app:defaultValue="unmapped" />
        <ListPreference
            app:key="button_map_thumbl"
            app:defaultValue="turbo" />
        <ListPreference
            app:key="button_map_thumbr"
            app:defaultValue="unmapped" />
        <ListPreference
            app:key="button_map_analogue_left"
            app:defaultValue="dpad" />
        <ListPreference
            app:key="button_map_analogue_right"
            app:defaultValue="tilt" />
    </PreferenceCategory>
</PreferenceScreen>
